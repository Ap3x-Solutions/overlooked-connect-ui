@model OverlookedConnect.PublicWeb.Models.ApplicantDashboardModel

@{
    ViewData["Title"] = "My Applications";
}

<style>
    .applicant-portal {
        background: #f7f5f0;
        min-height: 70vh;
        padding-bottom: 70px;
    }

    .portal-hero {
        background: #17345f;
        color: white;
        padding: 46px 0;
        border-right: 6px solid #d9a536;
    }

    .portal-container {
        width: min(1100px, 92%);
        margin: 0 auto;
    }

    .portal-eyebrow {
        color: #f0b83e;
        text-transform: uppercase;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .portal-hero h1 {
        font-size: 34px;
        font-weight: 700;
        margin: 0 0 8px;
    }

    .portal-hero p {
        margin: 0;
        color: #d9e2ef;
    }

    .dashboard-content {
        padding-top: 38px;
    }

    .dashboard-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .dashboard-top h2 {
        color: #10284b;
        margin: 0 0 5px;
        font-weight: 700;
    }

    .dashboard-top p {
        margin: 0;
        color: #667085;
    }

    .browse-btn {
        display: inline-block;
        background: #10284b;
        color: white;
        padding: 11px 18px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: 600;
    }

    .browse-btn:hover {
        color: white;
        background: #1c3c6a;
    }

    .application-card {
        background: white;
        border: 1px solid #e0e3e8;
        border-radius: 8px;
        margin-bottom: 18px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(16, 40, 75, 0.05);
    }

    .application-header {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
    }

    .application-title h3 {
        color: #10284b;
        margin: 0 0 6px;
        font-size: 20px;
        font-weight: 700;
    }

    .application-title p {
        color: #667085;
        margin: 0;
        font-size: 14px;
    }

    .status-badge {
        background: #e9f2ff;
        color: #245a9b;
        border-radius: 20px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 700;
        height: fit-content;
        white-space: nowrap;
    }

    .application-info {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        border-top: 1px solid #edf0f3;
        border-bottom: 1px solid #edf0f3;
        padding: 18px 0;
        margin-bottom: 18px;
    }

    .info-label {
        display: block;
        color: #7a8492;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 4px;
    }

    .info-value {
        color: #25344a;
        font-size: 14px;
        font-weight: 600;
    }

    .application-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 9px 15px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid #10284b;
        cursor: pointer;
    }

    .action-primary {
        background: #10284b;
        color: white;
    }

    .action-primary:hover {
        color: white;
    }

    .action-secondary {
        background: white;
        color: #10284b;
    }

    .action-danger {
        background: white;
        color: #a12828;
        border-color: #d4a1a1;
    }

    .empty-state {
        background: white;
        border: 1px solid #e0e3e8;
        border-radius: 8px;
        padding: 55px 25px;
        text-align: center;
    }

    .empty-icon {
        font-size: 34px;
        color: #c7922d;
        margin-bottom: 15px;
    }

    .empty-state h3 {
        color: #10284b;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #667085;
        margin-bottom: 22px;
    }

    .portal-message {
        background: #eaf4ec;
        color: #246536;
        border: 1px solid #c6dfcb;
        padding: 12px 16px;
        border-radius: 5px;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {
        .dashboard-top,
        .application-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .application-info {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="applicant-portal">

    <div class="portal-hero">
        <div class="portal-container">

            <div class="portal-eyebrow">
                Careers at Overlooked
            </div>

            <h1>My applications</h1>

            <p>
                Welcome back, @Model.ApplicantName.
                Track and manage your applications with Overlooked Group.
            </p>

        </div>
    </div>

    <div class="portal-container dashboard-content">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="portal-message">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="dashboard-top">

            <div>
                <h2>Application history</h2>

                <p>
                    View the current status of your submitted applications.
                </p>
            </div>

            <a asp-controller="Home"
               asp-action="Careers"
               class="browse-btn">

                <i class="fas fa-search me-1"></i>
                Browse vacancies

            </a>

        </div>

        @if (Model.Applications.Count == 0)
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="fas fa-briefcase"></i>
                </div>

                <h3>No applications yet</h3>

                <p>
                    Applications submitted while signed into your applicant
                    account will appear here.
                </p>

                <a asp-controller="Home"
                   asp-action="Careers"
                   class="browse-btn">

                    View current vacancies

                </a>

            </div>
        }
        else
        {
            @foreach (var application in Model.Applications)
            {
                <article class="application-card">

                    <div class="application-header">

                        <div class="application-title">

                            <h3>@application.VacancyTitle</h3>

                            <p>
                                @application.Department
                                @if (!string.IsNullOrWhiteSpace(application.Location))
                                {
                                    <span> • @application.Location</span>
                                }
                            </p>

                        </div>

                        <span class="status-badge">
                            @application.Status
                        </span>

                    </div>

                    <div class="application-info">

                        <div>
                            <span class="info-label">
                                Application reference
                            </span>

                            <span class="info-value">
                                @application.Reference
                            </span>
                        </div>

                        <div>
                            <span class="info-label">
                                Submitted
                            </span>

                            <span class="info-value">
                                @application.SubmittedAt.ToString("dd MMM yyyy")
                            </span>
                        </div>

                        <div>
                            <span class="info-label">
                                Location
                            </span>

                            <span class="info-value">
                                @application.Location
                            </span>
                        </div>

                    </div>

                    <div class="application-actions">

                        <a asp-controller="ApplicantPortal"
                           asp-action="Application"
                           asp-route-id="@application.ApplicationId"
                           class="action-btn action-primary">

                            View application

                        </a>

                        @if (application.CanEdit)
                        {
                            <a asp-controller="ApplicantPortal"
                               asp-action="Edit"
                               asp-route-id="@application.ApplicationId"
                               class="action-btn action-secondary">

                                Edit application

                            </a>
                        }

                        @if (application.CanWithdraw)
                        {
                            <form asp-controller="ApplicantPortal"
                                  asp-action="Withdraw"
                                  asp-route-id="@application.ApplicationId"
                                  method="post"
                                  style="display:inline;">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="action-btn action-danger"
                                        onclick="return confirm('Are you sure you want to withdraw this application?');">

                                    Withdraw

                                </button>

                            </form>
                        }

                    </div>

                </article>
            }
        }

    </div>

</section>