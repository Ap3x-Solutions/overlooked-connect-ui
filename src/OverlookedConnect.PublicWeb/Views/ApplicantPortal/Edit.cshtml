@model OverlookedConnect.PublicWeb.Models.ApplicantEditApplicationModel

@{
    ViewData["Title"] = "Edit Application";
}

<style>
    .edit-page {
        background: #f7f5f0;
        min-height: 70vh;
        padding-bottom: 70px;
    }

    .edit-hero {
        background: #17345f;
        color: white;
        padding: 42px 0;
        border-right: 6px solid #d9a536;
    }

    .edit-container {
        width: min(900px, 92%);
        margin: 0 auto;
    }

    .edit-eyebrow {
        color: #f0b83e;
        text-transform: uppercase;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .edit-hero h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 700;
    }

    .edit-hero p {
        margin: 0;
        color: #d9e2ef;
    }

    .edit-content {
        padding-top: 36px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #17345f;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 20px;
    }

    .back-link:hover {
        color: #c28b24;
    }

    .edit-card {
        background: white;
        border: 1px solid #e0e3e8;
        border-radius: 8px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(16, 40, 75, 0.05);
    }

    .edit-card h2 {
        color: #10284b;
        font-size: 23px;
        font-weight: 700;
        margin: 0 0 5px;
    }

    .edit-subtitle {
        color: #697386;
        margin-bottom: 28px;
    }

    .position-panel {
        background: #f7f9fc;
        border-left: 4px solid #d9a536;
        padding: 15px 18px;
        margin-bottom: 28px;
    }

    .position-label {
        display: block;
        color: #6c7686;
        text-transform: uppercase;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
        margin-bottom: 4px;
    }

    .position-title {
        color: #10284b;
        font-weight: 700;
        font-size: 16px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group-full {
        grid-column: 1 / -1;
    }

    .form-label {
        color: #10284b;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .form-control {
        width: 100%;
        border: 1px solid #d5dbe4;
        border-radius: 5px;
        padding: 11px 12px;
        font-size: 14px;
        color: #27364b;
        background: white;
    }

    .form-control:focus {
        border-color: #17345f;
        box-shadow: 0 0 0 2px rgba(23, 52, 95, .08);
        outline: none;
    }

    .field-validation-error,
    .validation-summary-errors {
        color: #b42318;
        font-size: 12px;
    }

    .field-validation-error {
        margin-top: 5px;
    }

    .validation-summary-errors {
        background: #fff2f0;
        border: 1px solid #f0c4be;
        border-radius: 5px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }

    .validation-summary-errors ul {
        margin: 0;
        padding-left: 18px;
    }

    .edit-note {
        background: #edf4fd;
        color: #315c92;
        padding: 12px 14px;
        border-radius: 5px;
        font-size: 13px;
        margin-top: 24px;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        border-top: 1px solid #e5e8ec;
        margin-top: 28px;
        padding-top: 22px;
    }

    .portal-btn {
        padding: 11px 18px;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

    .portal-btn-primary {
        background: #10284b;
        color: white;
        border: 1px solid #10284b;
    }

    .portal-btn-primary:hover {
        background: #1c3c6b;
        color: white;
    }

    .portal-btn-secondary {
        background: white;
        color: #10284b;
        border: 1px solid #10284b;
    }

    .portal-btn-secondary:hover {
        background: #f4f6f8;
        color: #10284b;
    }

    @@media (max-width: 700px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group-full {
            grid-column: auto;
        }

        .edit-card {
            padding: 22px;
        }
    }
</style>

<section class="edit-page">

    <div class="edit-hero">
        <div class="edit-container">

            <div class="edit-eyebrow">
                Careers at Overlooked
            </div>

            <h1>Edit application</h1>

            <p>
                Update your application information before it moves
                to the next stage of recruitment.
            </p>

        </div>
    </div>

    <div class="edit-container edit-content">

        <a asp-controller="ApplicantPortal"
           asp-action="Application"
           asp-route-id="@Model.ApplicationId"
           class="back-link">

            <i class="fas fa-arrow-left"></i>
            Back to application

        </a>

        <div class="edit-card">

            <h2>Application information</h2>

            <p class="edit-subtitle">
                Review and update the information below.
            </p>

            <div class="position-panel">

                <span class="position-label">
                    Position applied for
                </span>

                <span class="position-title">
                    @Model.VacancyTitle
                </span>

            </div>

            <form asp-controller="ApplicantPortal"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="ApplicationId"
                       type="hidden" />

                <input asp-for="VacancyTitle"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"></div>

                <div class="form-grid">

                    <div class="form-group form-group-full">

                        <label asp-for="ApplicantName"
                               class="form-label">
                            Full name *
                        </label>

                        <input asp-for="ApplicantName"
                               class="form-control"
                               autocomplete="name" />

                        <span asp-validation-for="ApplicantName"></span>

                    </div>

                    <div class="form-group">

                        <label asp-for="PhoneNumber"
                               class="form-label">
                            Contact number *
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control"
                               autocomplete="tel" />

                        <span asp-validation-for="PhoneNumber"></span>

                    </div>

                    <div class="form-group">

                        <label asp-for="YearsExperience"
                               class="form-label">
                            Years of experience *
                        </label>

                        <input asp-for="YearsExperience"
                               class="form-control" />

                        <span asp-validation-for="YearsExperience"></span>

                    </div>

                    <div class="form-group form-group-full">

                        <label asp-for="Qualification"
                               class="form-label">
                            Qualification *
                        </label>

                        <input asp-for="Qualification"
                               class="form-control" />

                        <span asp-validation-for="Qualification"></span>

                    </div>

                </div>

                <div class="edit-note">
                    <i class="fas fa-info-circle me-1"></i>

                    Your vacancy, email address, ID number and uploaded
                    CV cannot be changed from this page.
                </div>

                <div class="form-actions">

                    <button type="submit"
                            class="portal-btn portal-btn-primary">

                        Save changes

                    </button>

                    <a asp-controller="ApplicantPortal"
                       asp-action="Application"
                       asp-route-id="@Model.ApplicationId"
                       class="portal-btn portal-btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}