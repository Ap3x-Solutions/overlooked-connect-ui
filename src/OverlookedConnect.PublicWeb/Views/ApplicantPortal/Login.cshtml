@model OverlookedConnect.PublicWeb.Models.ApplicantLoginModel

@{
    ViewData["Title"] = "Applicant Login";
}

<div class="page-hero">
    <div class="container">
        <span class="eyebrow">CAREERS AT OVERLOOKED</span>
        <h1>Applicant portal</h1>

        <div class="breadcrumb-trail">
            <a asp-controller="Home" asp-action="Index">Home</a>
            &rsaquo;
            <a asp-controller="Home" asp-action="Careers">Careers</a>
            &rsaquo; Applicant Login
        </div>
    </div>
</div>

<div class="container py-5" style="max-width: 650px;">

    <div class="card p-4 p-md-5">

        <div class="text-center mb-4">

            <div class="mb-3">
                <i class="fas fa-user"
                   style="font-size:2rem; color:var(--gold-dark);"></i>
            </div>

            <h3 class="mb-2">Welcome back</h3>

            <p class="text-muted mb-0">
                Sign in to view and manage your job applications.
            </p>

        </div>

        <form asp-controller="ApplicantPortal"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">
                    Email address *
                </label>

                <input asp-for="Email"
                       class="form-control"
                       autocomplete="email"
                       placeholder="you@example.co.za" />

                <span asp-validation-for="Email"
                      class="text-danger d-block">
                </span>

            </div>

            <div class="mb-4">

                <label asp-for="Password"
                       class="form-label">
                    Password *
                </label>

                <input asp-for="Password"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Enter your password" />

                <span asp-validation-for="Password"
                      class="text-danger d-block">
                </span>

            </div>

            <button type="submit"
                    class="btn btn-navy w-100">
                <i class="fas fa-arrow-right-to-bracket me-2"></i>
                Sign in
            </button>

        </form>

        <hr class="my-4" />

        <div class="text-center">

            <p class="text-muted mb-2">
                Applying with Overlooked for the first time?
            </p>

            <a asp-controller="ApplicantPortal"
               asp-action="Register"
               class="fw-semibold"
               style="color:var(--navy-900);">
                Create an applicant account
                <i class="fas fa-arrow-right ms-1"></i>
            </a>

        </div>

    </div>

    <div class="text-center mt-4">
        <a asp-controller="Home"
           asp-action="Careers"
           class="text-muted">
            <i class="fas fa-arrow-left me-1"></i>
            Return to current vacancies
        </a>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}