@{
    ViewData["Title"] = "Leadership & Governance";
}

<div class="page-hero">
    <div class="container">
        <span class="eyebrow">ABOUT OVERLOOKED</span>
        <h1>Leadership &amp; governance</h1>
        <div class="breadcrumb-trail"><a asp-action="Index">Home</a> &rsaquo; Our Business &rsaquo; Leadership</div>
    </div>
</div>

<div class="container py-5">
    <h3 class="mb-1">Board of Directors</h3>
    <p class="text-muted mb-4">Our board brings together mining operations, finance and community development experience.</p>

    <div class="row g-4 mb-5">
        <div class="col-md-3 col-6">
            <div class="card leader-card h-100">
                <div class="leader-photo">
                    <div class="leader-avatar">TM</div>
                </div>
                <div class="card-body">
                    <h5 class="mb-0">Thabo Mahlangu</h5>
                    <p class="leader-role">Chief Executive Officer</p>
                    <p class="text-muted small mb-0">24 years in coal mining operations. Previously GM at Highveld Collieries.</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card leader-card h-100">
                <div class="leader-photo">
                    <div class="leader-avatar">NS</div>
                </div>
                <div class="card-body">
                    <h5 class="mb-0">Naledi Sithole</h5>
                    <p class="leader-role">Chief Financial Officer</p>
                    <p class="text-muted small mb-0">Chartered Accountant (SA). Led the 2021 Katlego acquisition financing.</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card leader-card h-100">
                <div class="leader-photo">
                    <div class="leader-avatar">PZ</div>
                </div>
                <div class="card-body">
                    <h5 class="mb-0">Pieter van Zyl</h5>
                    <p class="leader-role">Chief Operating Officer</p>
                    <p class="text-muted small mb-0">Mine Manager's Certificate. Oversees all five collieries.</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card leader-card h-100">
                <div class="leader-photo green">
                    <div class="leader-avatar">ZK</div>
                </div>
                <div class="card-body">
                    <h5 class="mb-0">Zanele Khumalo</h5>
                    <p class="leader-role">Executive: Sustainability</p>
                    <p class="text-muted small mb-0">Drives ESG strategy, rehabilitation and community investment.</p>
                </div>
            </div>
        </div>
    </div>

    <h3 class="mb-4">Governance framework</h3>
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="callout">
                <h5 class="mb-2">Board Committees</h5>
                <p class="text-muted mb-3">Audit &amp; Risk &middot; Social &amp; Ethics &middot; Remuneration</p>
                <span class="pill pill-navy">4 meetings per year</span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="callout">
                <h5 class="mb-2">B-BBEE</h5>
                <p class="text-muted mb-3">Level 1 contributor, 135% procurement recognition</p>
                <span class="pill pill-navy">Verified annually</span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="callout">
                <h5 class="mb-2">Whistleblower Line</h5>
                <p class="text-muted mb-3">0800 20 20 20 &mdash; independently operated</p>
                <span class="pill pill-navy">Anonymous reporting</span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="callout">
                <h5 class="mb-2">POPIA Compliance</h5>
                <p class="text-muted mb-3">Information Officer registered with the Regulator</p>
                <span class="pill pill-navy">Reviewed annually</span>
            </div>
        </div>
    </div>

    <div class="quote-banner">
        <span class="eyebrow">Our purpose</span>
        <blockquote>&ldquo;Mining is how we start the conversation. Empowerment is how we finish it.&rdquo;</blockquote>
        <cite>Thabo Mahlangu, Chief Executive Officer</cite>
    </div>
</div>
