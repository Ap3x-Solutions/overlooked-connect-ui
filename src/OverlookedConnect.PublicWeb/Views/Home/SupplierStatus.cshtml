@model SupplierStatusModel
@{
    ViewData["Title"] = "Application status";

    string PillClass(string status) => status switch
    {
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        "DocumentsVerified" => "bg-success",
        _ => "bg-warning text-dark"
    };

    string Readable(string status) => status switch
    {
        "UnderReview" => "Under review",
        "DocumentsVerified" => "Documents verified",
        _ => status
    };
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">SUPPLIER &amp; SMME PORTAL</span>
        <h1>Application status</h1>
        <p class="breadcrumb-trail">Home &rsaquo; Suppliers &rsaquo; My application</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-4">

            <div class="col-lg-7">
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <h2 class="h4 mb-1">@Model.CompanyName</h2>
                            <p class="text-muted small mb-0">Reference @Model.Reference</p>
                        </div>
                        <span class="badge @PillClass(Model.Status)">@Readable(Model.Status).ToUpper()</span>
                    </div>

                    <hr />

                    <div class="row g-3 small">
                        <div class="col-6">
                            <span class="text-muted d-block">Submitted</span>
                            <strong>@Model.SubmittedAt.ToString("dd MMMM yyyy")</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block">Documents verified</span>
                            <strong>@Model.DocumentsVerified of @Model.DocumentsRequired</strong>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.VendorNumber))
                        {
                            <div class="col-12">
                                <span class="text-muted d-block">Vendor number</span>
                                <strong>@Model.VendorNumber</strong>
                            </div>
                        }
                    </div>

                    @if (Model.Status == "Approved")
                    {
                        <div class="alert alert-success mt-4 mb-0">
                            <strong>Approved.</strong> You are now an approved OVL supplier and will
                            receive tender notifications for your registered category.
                        </div>
                    }
                    else if (Model.DocumentsVerified < Model.DocumentsRequired)
                    {
                        <div class="alert alert-warning mt-4 mb-0">
                            @(Model.DocumentsRequired - Model.DocumentsVerified) outstanding
                            document(s) are delaying your review.
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card p-4">
                    <h3 class="h6 mb-3">Compliance documents</h3>

                    @foreach (var doc in Model.Documents)
                    {
                        var colour = doc.Status switch
                        {
                            "Verified" => "#22A55B",
                            "Pending"  => "#E08E0B",
                            _          => "#C0392B"
                        };
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom small">
                            <span>
                                <span class="d-inline-block me-2"
                                      style="width:10px;height:10px;border-radius:50%;background:@colour;"></span>
                                @doc.DocType
                            </span>
                            <span style="color:@colour;font-weight:600;">@doc.Status</span>
                        </div>
                    }

                    <a asp-controller="Home" asp-action="Suppliers" class="btn btn-outline-secondary w-100 mt-4">
                        Back to the supplier portal
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>
