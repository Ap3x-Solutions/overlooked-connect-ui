@using System.Text.Json
@using OverlookedConnect.PublicWeb.Services

@{
    ViewData["Title"] = "Careers";

    var vacancies =
        ViewBag.Vacancies as List<ApiVacancy>
        ?? new List<ApiVacancy>();

    var firstVacancy = vacancies.FirstOrDefault();
}

<div class="page-hero">
    <div class="container">
        <span class="eyebrow">CAREERS AT OVERLOOKED</span>
        <h1>Build your career in mining</h1>

        <div class="breadcrumb-trail">
            <a asp-action="Index">Home</a> &rsaquo; Careers
        </div>
    </div>
</div>

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="mb-1">Open positions</h4>

            @if (vacancies.Count > 0)
            {
                <p class="text-muted mb-0">
                    @vacancies.Count open position@(vacancies.Count == 1 ? "" : "s")
                    currently available.
                </p>
            }
            else
            {
                <p class="text-muted mb-0">
                    There are currently no vacancies available.
                </p>
            }
        </div>

        @if (vacancies.Count > 0)
        {
            <span class="badge bg-success">
                @vacancies.Count open position@(vacancies.Count == 1 ? "" : "s")
            </span>
        }
    </div>

    @if (vacancies.Count == 0)
    {
        <div class="card p-5 text-center">
            <h5 class="mb-2">No open positions</h5>

            <p class="text-muted mb-0">
                There are no vacancies available at the moment.
                Please check again later.
            </p>
        </div>
    }
    else
    {
        var departments = vacancies
            .Where(v => !string.IsNullOrWhiteSpace(v.Department))
            .Select(v => v.Department)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(d => d)
            .ToList();

        <ul class="nav pill-tabs mb-4" id="deptFilter">
            <li class="nav-item">
                <button class="nav-link active"
                        type="button"
                        data-filter="all">
                    All departments
                </button>
            </li>

            @foreach (var department in departments)
            {
                <li class="nav-item">
                    <button class="nav-link"
                            type="button"
                            data-filter="@department">
                        @department
                    </button>
                </li>
            }
        </ul>

        <div class="row g-4">

            <div class="col-lg-7" id="jobList">

                @for (var i = 0; i < vacancies.Count; i++)
                {
                    var vacancy = vacancies[i];

                    var requirementsJson =
                        JsonSerializer.Serialize(
                            vacancy.Requirements ?? new List<string>());

                    <div class="job-row @(i == 0 ? "selected" : "")"
                         data-vacancy-id="@vacancy.VacancyId"
                         data-department="@vacancy.Department"
                         data-title="@vacancy.Title"
                         data-meta="@($"{vacancy.Department} · {vacancy.Site}")"
                         data-tag="@vacancy.EmploymentType"
                         data-closes="@vacancy.ClosingDate.ToString("dd MMM yyyy")"
                         data-purpose="@vacancy.Purpose"
                         data-requirements="@requirementsJson">

                        <div>
                            <h5 class="mb-1">
                                @vacancy.Title
                            </h5>

                            <p class="text-muted small mb-0">
                                @vacancy.Department &middot; @vacancy.Site
                            </p>
                        </div>

                        <div class="text-end">
                            <span class="pill pill-navy d-block mb-1">
                                @vacancy.EmploymentType
                            </span>

                            <small class="text-muted">
                                Closes @vacancy.ClosingDate.ToString("dd MMM yyyy")
                            </small>
                        </div>

                    </div>
                }

            </div>

            <div class="col-lg-5">

                <div class="job-detail-panel" id="jobDetail">

                    @if (firstVacancy is not null)
                    {
                        <h4 id="detailTitle" class="mb-1">
                            @firstVacancy.Title
                        </h4>

                        <p id="detailMeta"
                           class="text-muted mb-1">
                            @firstVacancy.Department &middot; @firstVacancy.Site
                        </p>

                        <div class="mb-3">
                            <span id="detailTag"
                                  class="pill pill-navy">
                                @firstVacancy.EmploymentType
                            </span>

                            <small id="detailClosing"
                                   class="text-muted ms-2">
                                Closes @firstVacancy.ClosingDate.ToString("dd MMM yyyy")
                            </small>
                        </div>

                        <hr />

                        <h6 class="mt-3 mb-2">
                            Purpose of the role
                        </h6>

                        <p id="detailPurpose"
                           class="text-muted small">
                            @firstVacancy.Purpose
                        </p>

                        <h6 class="mt-3 mb-2">
                            Minimum requirements
                        </h6>

                        <ul class="text-muted small"
                            id="detailReq"
                            style="padding-left:1.1rem;">

                            @foreach (var requirement in firstVacancy.Requirements)
                            {
                                <li>@requirement</li>
                            }

                        </ul>

                        <a asp-action="CareersApply"
                           asp-route-vacancyId="@firstVacancy.VacancyId"
                           asp-route-position="@firstVacancy.Title"
                           id="applyLink"
                           class="btn btn-navy w-100 mt-3">
                            Apply for this role
                        </a>
                    }

                </div>

            </div>

        </div>
    }

</div>

@section Scripts
{
    <script>
        (function () {

            const rows =
                document.querySelectorAll(".job-row");

            if (!rows.length) {
                return;
            }

            const detailTitle =
                document.getElementById("detailTitle");

            const detailMeta =
                document.getElementById("detailMeta");

            const detailTag =
                document.getElementById("detailTag");

            const detailClosing =
                document.getElementById("detailClosing");

            const detailPurpose =
                document.getElementById("detailPurpose");

            const detailReq =
                document.getElementById("detailReq");

            const applyLink =
                document.getElementById("applyLink");

            function selectRow(row) {

                rows.forEach(r =>
                    r.classList.remove("selected"));

                row.classList.add("selected");

                const vacancyId =
                    row.dataset.vacancyId;

                const title =
                    row.dataset.title;

                detailTitle.textContent =
                    title;

                detailMeta.textContent =
                    row.dataset.meta;

                detailTag.textContent =
                    row.dataset.tag;

                detailClosing.textContent =
                    "Closes " + row.dataset.closes;

                detailPurpose.textContent =
                    row.dataset.purpose;

                let requirements = [];

                try {
                    requirements =
                        JSON.parse(
                            row.dataset.requirements || "[]");
                }
                catch {
                    requirements = [];
                }

                detailReq.innerHTML = "";

                requirements.forEach(requirement => {

                    const li =
                        document.createElement("li");

                    li.textContent =
                        requirement;

                    detailReq.appendChild(li);
                });

                const url =
                    new URL(
                        applyLink.href,
                        window.location.origin);

                url.searchParams.set(
                    "vacancyId",
                    vacancyId);

                url.searchParams.set(
                    "position",
                    title);

                applyLink.href =
                    url.pathname + url.search;
            }

            rows.forEach(row => {

                row.addEventListener(
                    "click",
                    function () {
                        selectRow(row);
                    });
            });

            const filterButtons =
                document.querySelectorAll(
                    "#deptFilter .nav-link");

            filterButtons.forEach(button => {

                button.addEventListener(
                    "click",
                    function () {

                        filterButtons.forEach(btn =>
                            btn.classList.remove("active"));

                        this.classList.add("active");

                        const filter =
                            this.dataset.filter;

                        rows.forEach(row => {

                            row.style.display =
                                filter === "all" ||
                                row.dataset.department === filter
                                    ? "flex"
                                    : "none";
                        });

                        const firstVisible =
                            Array.from(rows)
                                .find(row =>
                                    row.style.display !== "none");

                        if (firstVisible) {
                            selectRow(firstVisible);
                        }
                    });
            });

            selectRow(rows[0]);

        })();
    </script>
}