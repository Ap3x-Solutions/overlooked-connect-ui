@{
    ViewData["Title"] = "Careers";
}

<div class="page-hero">
    <div class="container">
        <span class="eyebrow">CAREERS AT OVERLOOKED</span>
        <h1>Build your career in mining</h1>
        <div class="breadcrumb-trail"><a asp-action="Index">Home</a> &rsaquo; Careers</div>
    </div>
</div>

<div class="container py-5">
    <h4 class="mb-1">Open positions</h4>
    <p class="text-muted mb-4">4 roles currently advertised across our Mpumalanga operations.</p>

    <ul class="nav pill-tabs" id="deptFilter">
        <li class="nav-item"><button class="nav-link active" type="button" data-filter="all">All departments</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-filter="Mining Operations">Mining Operations</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-filter="Engineering">Engineering</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-filter="Health & Safety">Safety</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-filter="Corporate">Corporate</button></li>
    </ul>

    <div class="row g-4">
        <div class="col-lg-7" id="jobList">
            <div class="job-row selected"
                 data-department="Mining Operations"
                 data-title="Shift Supervisor"
                 data-meta="Mining Operations &middot; Forzando South"
                 data-tag="Permanent"
                 data-closes="Closes 22 Aug 2026"
                 data-purpose="Supervise a production shift, enforce safety standards and meet daily ROM targets across the section."
                 data-req="Blasting Certificate (Fiery Mine)|5 years underground supervisory experience|Valid Red Ticket medical certificate|Grade 12 with Mathematics">
                <div>
                    <h5 class="mb-1">Shift Supervisor</h5>
                    <p class="text-muted small mb-0">Mining Operations &middot; Forzando South</p>
                </div>
                <div class="text-end">
                    <span class="pill pill-navy d-block mb-1">Permanent</span>
                    <small class="text-muted">Closes 22 Aug 2026</small>
                </div>
            </div>

            <div class="job-row"
                 data-department="Health & Safety"
                 data-title="Safety Officer"
                 data-meta="Health &amp; Safety &middot; Dorstfontein West"
                 data-tag="Permanent"
                 data-closes="Closes 29 Aug 2026"
                 data-purpose="Monitor compliance with the Mine Health and Safety Act, run toolbox talks and lead incident investigations."
                 data-req="SAMTRAC or equivalent|3 years safety officer experience|Valid Red Ticket medical certificate|Grade 12">
                <div>
                    <h5 class="mb-1">Safety Officer</h5>
                    <p class="text-muted small mb-0">Health &amp; Safety &middot; Dorstfontein West</p>
                </div>
                <div class="text-end">
                    <span class="pill pill-navy d-block mb-1">Permanent</span>
                    <small class="text-muted">Closes 29 Aug 2026</small>
                </div>
            </div>

            <div class="job-row"
                 data-department="Engineering"
                 data-title="Diesel Mechanic"
                 data-meta="Engineering &middot; Overlooked Colliery"
                 data-tag="Permanent"
                 data-closes="Closes 15 Aug 2026"
                 data-purpose="Maintain and repair diesel-powered mobile fleet to maximise equipment availability across the opencast section."
                 data-req="Trade Tested Diesel Mechanic|4 years heavy equipment experience|Valid driver's licence|Willingness to work shifts">
                <div>
                    <h5 class="mb-1">Diesel Mechanic</h5>
                    <p class="text-muted small mb-0">Engineering &middot; Overlooked Colliery</p>
                </div>
                <div class="text-end">
                    <span class="pill pill-navy d-block mb-1">Permanent</span>
                    <small class="text-muted">Closes 15 Aug 2026</small>
                </div>
            </div>

            <div class="job-row"
                 data-department="Mining Operations"
                 data-title="Graduate Geologist"
                 data-meta="Mining Operations &middot; Emalahleni"
                 data-tag="Graduate programme"
                 data-closes="Closes 05 Sep 2026"
                 data-purpose="Join our two-year graduate programme rotating through exploration, grade control and resource modelling."
                 data-req="BSc Geology (Honours)|Grade 12 with Mathematics and Physical Science|South African citizen|Willing to relocate to Mpumalanga">
                <div>
                    <h5 class="mb-1">Graduate Geologist</h5>
                    <p class="text-muted small mb-0">Mining Operations &middot; Emalahleni</p>
                </div>
                <div class="text-end">
                    <span class="pill pill-navy d-block mb-1">Graduate programme</span>
                    <small class="text-muted">Closes 05 Sep 2026</small>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="job-detail-panel" id="jobDetail">
                <h4 id="detailTitle" class="mb-1">Shift Supervisor</h4>
                <p id="detailMeta" class="text-muted mb-3">Mining Operations &middot; Forzando South</p>
                <hr />
                <h6 class="mt-3 mb-2">Purpose of the role</h6>
                <p id="detailPurpose" class="text-muted small"></p>
                <h6 class="mt-3 mb-2">Minimum requirements</h6>
                <ul class="text-muted small" id="detailReq" style="padding-left:1.1rem;"></ul>
                <a asp-action="CareersApply" id="applyLink" asp-route-position="Shift Supervisor" class="btn btn-navy w-100 mt-3">Apply for this role</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const rows = document.querySelectorAll('.job-row');
            const detailTitle = document.getElementById('detailTitle');
            const detailMeta = document.getElementById('detailMeta');
            const detailPurpose = document.getElementById('detailPurpose');
            const detailReq = document.getElementById('detailReq');
            const applyLink = document.getElementById('applyLink');

            function selectRow(row) {
                rows.forEach(r => r.classList.remove('selected'));
                row.classList.add('selected');
                detailTitle.textContent = row.dataset.title;
                detailMeta.innerHTML = row.dataset.meta;
                detailPurpose.textContent = row.dataset.purpose;
                detailReq.innerHTML = row.dataset.req.split('|').map(r => `<li>${r}</li>`).join('');
                applyLink.setAttribute('href', applyLink.getAttribute('href').split('?')[0] + '?position=' + encodeURIComponent(row.dataset.title));
            }

            rows.forEach(row => row.addEventListener('click', () => selectRow(row)));
            if (rows.length) selectRow(rows[0]);

            document.querySelectorAll('#deptFilter .nav-link').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('#deptFilter .nav-link').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    const filter = this.dataset.filter;
                    rows.forEach(row => {
                        row.style.display = (filter === 'all' || row.dataset.department === filter) ? 'flex' : 'none';
                    });
                });
            });
        })();
    </script>
}

