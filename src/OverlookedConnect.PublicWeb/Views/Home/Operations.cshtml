@{
    ViewData["Title"] = "Operations";
}

<div class="page-hero">
    <div class="container">
        <span class="eyebrow">OUR OPERATIONS</span>
        <h1>Five collieries across Mpumalanga</h1>
        <div class="breadcrumb-trail"><a asp-action="Index">Home</a> &rsaquo; Operations</div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 mb-5">
        <div class="col-6 col-md-3">
            <div class="stat-card"><h2>9.7 Mt</h2><p class="mb-0 small">Combined ROM p.a.</p></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card"><h2>5</h2><p class="mb-0 small">Active collieries</p></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card"><h2>2</h2><p class="mb-0 small">Asset clusters</p></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card"><h2>248</h2><p class="mb-0 small">Permanent employees</p></div>
        </div>
    </div>

    <h3 class="mb-1">Tswelopele Operations</h3>
    <p class="text-muted mb-4">4.1 Mt ROM per annum &middot; Emalahleni district</p>

    <div class="card mb-5">
        <div class="row g-0">
            <div class="col-md-4">
                <div class="card-photo h-100" style="min-height:220px;">
                    <span class="card-photo-badge">OPENCAST</span>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card-body h-100">
                    <h5 class="mb-2">Overlooked Colliery</h5>
                    <p class="text-muted mb-4">The group's founding operation, in production since 2018. Supplies Eskom under a long-term offtake agreement, with export-grade product railed to Richards Bay.</p>
                    <div class="row">
                        <div class="col-sm-6 mb-2">
                            <small class="text-muted d-block">Method</small>
                            <strong>Opencast</strong>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <small class="text-muted d-block">Product</small>
                            <strong>Thermal coal, 4 800 kcal</strong>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Primary customer</small>
                            <strong>Eskom</strong>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Workforce</small>
                            <strong>96 permanent</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h3 class="mb-1">Katlego Operations</h3>
    <p class="text-muted mb-4">5.6 Mt ROM per annum &middot; acquired 2021 &middot; four operations</p>

    <div class="row g-4 mb-5">
        <div class="col-md-3 col-6">
            <div class="card h-100">
                <div class="card-photo"><span class="card-photo-badge">1.8 Mt ROM</span></div>
                <div class="card-body">
                    <h5 class="mb-1">Dorstfontein Opencast</h5>
                    <p class="text-muted small mb-3">Opencast</p>
                    <a asp-action="Operations" class="card-link-arrow">View operation &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card h-100">
                <div class="card-photo"><span class="card-photo-badge">1.4 Mt ROM</span></div>
                <div class="card-body">
                    <h5 class="mb-1">Dorstfontein West Underground</h5>
                    <p class="text-muted small mb-3">Underground</p>
                    <a asp-action="Operations" class="card-link-arrow">View operation &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card h-100">
                <div class="card-photo"><span class="card-photo-badge">1.1 Mt ROM</span></div>
                <div class="card-body">
                    <h5 class="mb-1">Forzando North</h5>
                    <p class="text-muted small mb-3">Underground</p>
                    <a asp-action="Operations" class="card-link-arrow">View operation &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card h-100">
                <div class="card-photo"><span class="card-photo-badge">1.3 Mt ROM</span></div>
                <div class="card-body">
                    <h5 class="mb-1">Forzando South</h5>
                    <p class="text-muted small mb-3">Underground</p>
                    <a asp-action="Operations" class="card-link-arrow">View operation &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="callout callout-green">
        <h5 class="mb-2">Safety performance</h5>
        <p class="mb-0 text-muted">Group LTIFR of 0.11 over the trailing 12 months, against an internal target of 0.15. Every incident is logged, investigated and verified before closure.</p>
    </div>
</div>
