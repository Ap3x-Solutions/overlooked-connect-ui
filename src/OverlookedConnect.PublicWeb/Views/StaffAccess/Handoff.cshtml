@model StaffHandoffModel
@{
    ViewData["Title"] = "Signing you in";
    Layout = null;   /* deliberately bare: this page exists only long enough to submit */
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@ViewData["Title"] — Overlooked Connect</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { margin:0; font-family:Inter,system-ui,sans-serif;
               background:linear-gradient(118deg,#0F1E3A,#254070); color:#fff;
               display:grid; place-items:center; height:100vh; text-align:center; }
        .mark { width:56px; height:56px; border-radius:12px; background:#D4A544; color:#0F1E3A;
                display:grid; place-items:center; font-size:28px; font-weight:800; margin:0 auto 22px; }
        h1 { font-size:20px; font-weight:800; margin:0 0 8px; }
        p  { color:#C6D2E6; font-size:14px; margin:0; }
        .bar { width:220px; height:4px; border-radius:2px; background:rgba(255,255,255,.18);
               margin:26px auto 0; overflow:hidden; }
        .bar i { display:block; height:100%; width:40%; background:#D4A544; border-radius:2px;
                 animation:slide 1s ease-in-out infinite; }
        @@keyframes slide { 0%{transform:translateX(-100%)} 100%{transform:translateX(320%)} }
        noscript p { color:#fff; margin-top:20px; }
        button { margin-top:18px; padding:12px 26px; border:0; border-radius:8px;
                 background:#D4A544; color:#0F1E3A; font-weight:700; font-size:15px; cursor:pointer; }
    </style>
</head>
<body>
    <div>
        <div class="mark">O</div>
        <h1>Signing you in, @Model.FullName</h1>
        <p>Taking you to the internal operations platform as @Model.Role.</p>
        <div class="bar"><i></i></div>

        @*
            The token travels in the POST body, never in the URL. A token in a query string would be
            recorded in browser history, server access logs and any outbound Referer header.
            The internal platform re-validates it against the API before establishing a session.
        *@
        <form id="sso" method="post" action="@Model.PostUrl">
            <input type="hidden" name="token" value="@Model.AccessToken" />
            <noscript>
                <p>JavaScript is disabled. Select continue to complete sign-in.</p>
                <button type="submit">Continue to the internal platform</button>
            </noscript>
        </form>
    </div>

    <script>
        /* Submit immediately; the visible content is only for the brief moment before navigation. */
        document.getElementById("sso").submit();
    </script>
</body>
</html>
