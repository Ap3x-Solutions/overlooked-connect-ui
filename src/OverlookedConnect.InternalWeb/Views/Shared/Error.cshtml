@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_LoginLayout";
}
<div class="container py-5 text-center">
    <h1 class="mb-3">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred while processing your request.</p>
    @if (Model?.ShowRequestId ?? false)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn-ovl d-inline-block mt-3" asp-controller="Dashboard" asp-action="Index">Return to dashboard</a>
</div>
