@{
    string CurrentController() => ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(params string[] controllers) =>
        controllers.Contains(CurrentController()) ? "active" : "";

    var userName = Context.Session.GetString("UserName") ?? "T. Mahlangu";
    var userInitials = Context.Session.GetString("UserInitials") ?? "TM";
    var userRole = Context.Session.GetString("UserRole") ?? "Executive";
    var roleKey = Context.Session.GetString("RoleKey")?.ToLowerInvariant() ?? "employee";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
        name="description"
        content="Overlooked Connect - Internal Operations Platform" />

    <title>@ViewData["Title"] - Overlooked Connect</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com">

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link
        rel="stylesheet"
        href="~/css/internal.css"
        asp-append-version="true" />
</head>

<body>

    <aside class="app-sidebar" id="appSidebar">

        <div class="sidebar-brand">
            <span class="brand-mark">O</span>

            <span class="brand-text">
                <b>OVERLOOKED</b>
                <span>Connect &middot; Internal</span>
            </span>
        </div>

        <ul class="nav-list">

            @* Executive, HR, Safety and Procurement dashboard *@
            @if (roleKey is "executive" or "hr" or "safety" or "procurement")
            {
                <li>
                    <a
                        class="@Active("Dashboard")"
                        asp-controller="Dashboard"
                        asp-action="Index">
                        <i class="fas fa-table-columns"></i>
                        Dashboard
                    </a>
                </li>
            }

            @* Executive and HR employee management *@
            @if (roleKey is "executive" or "hr")
            {
                <li>
                    <a
                        class="@Active("Employees")"
                        asp-controller="Employees"
                        asp-action="Index">
                        <i class="fas fa-users"></i>
                        Employees
                    </a>
                </li>

                <li>
                    <a
                        class="@Active("Leave")"
                        asp-controller="Leave"
                        asp-action="Index">
                        <i class="fas fa-calendar-days"></i>
                        Leave &amp; Shifts
                    </a>
                </li>
            }

            @* Executive and Safety incident management *@
            @if (roleKey is "executive" or "safety")
            {
                <li>
                    <a
                        class="@Active("Safety")"
                        asp-controller="Safety"
                        asp-action="Index">
                        <i class="fas fa-triangle-exclamation"></i>
                        Safety &amp; Incidents
                    </a>
                </li>
            }

            @* Executive and Procurement supplier management *@
            @if (roleKey is "executive" or "procurement")
            {
                <li>
                    <a
                        class="@Active("Suppliers")"
                        asp-controller="Suppliers"
                        asp-action="Index">
                        <i class="fas fa-truck-field"></i>
                        Suppliers
                    </a>
                </li>
            }

            @* Executive and HR community/reporting functions *@
            @if (roleKey is "executive" or "hr")
            {
                <li>
                    <a
                        class="@Active("Community")"
                        asp-controller="Community"
                        asp-action="Index">
                        <i class="fas fa-hand-holding-heart"></i>
                        Community &amp; CSR
                    </a>
                </li>

                <li>
                    <a
                        class="@Active("Reports", "Audit")"
                        asp-controller="Reports"
                        asp-action="Index">
                        <i class="fas fa-chart-column"></i>
                        Reports
                    </a>
                </li>
            }

            @* Employee self-service portal *@
            @if (roleKey == "employee")
            {
                <li>
                    <a
                        class="@Active("Staff")"
                        asp-controller="Staff"
                        asp-action="Index">
                        <i class="fas fa-id-badge"></i>
                        Self-Service
                    </a>
                </li>
            }

        </ul>

        <div class="sidebar-user">

            <span
                class="avatar avatar-sm"
                style="background-color:#D4A544;color:#0F1E3A;">
                @userInitials
            </span>

            <span class="flex-grow-1">
                <span class="u-name">@userName</span>
                <span class="u-role">@userRole</span>
            </span>

            <a
                asp-controller="Account"
                asp-action="Logout"
                title="Sign out"
                aria-label="Sign out">
                <i class="fas fa-right-from-bracket"></i>
            </a>

        </div>

    </aside>

    <div class="app-main">

        <div class="app-topbar">

            <button
                class="sidebar-toggle"
                id="sidebarToggle"
                type="button"
                aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>

            <div class="search-box">
                <i class="fas fa-magnifying-glass"></i>

                <input
                    type="search"
                    placeholder="Search employees, incidents, suppliers…"
                    aria-label="Search" />
            </div>

            <div class="ms-auto d-flex align-items-center gap-3">

                <span class="bell">
                    <i class="fas fa-bell"></i>
                    <span class="dot"></span>
                </span>

                <span
                    class="avatar avatar-md"
                    style="background-color:#0F1E3A;">
                    @userInitials
                </span>

            </div>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div
                class="alert alert-success alert-dismissible fade show rounded-0 mb-0 border-0"
                role="alert">

                <div class="px-3">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["SuccessMessage"]
                </div>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
                </button>

            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div
                class="alert alert-danger alert-dismissible fade show rounded-0 mb-0 border-0"
                role="alert">

                <div class="px-3">
                    <i class="fas fa-circle-exclamation me-2"></i>
                    @TempData["ErrorMessage"]
                </div>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
                </button>

            </div>
        }

        <main class="app-content" role="main">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script
        src="~/js/internal.js"
        asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>