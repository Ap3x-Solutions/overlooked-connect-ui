
@model ReportRequestModel

@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="page-head">
    <div>
        <h1>Reports &amp; Analytics</h1>
        <p class="sub">
            Generate downloadable reports from live
            Overlooked Connect records.
        </p>
    </div>

    <a class="btn-ovl-ghost"
       asp-controller="Audit"
       asp-action="Index">
        <i class="fas fa-shield-halved me-2"></i>
        Audit log
    </a>
</div>

<div class="card mb-4">
    <div class="card-body p-4">

        <h2 class="card-title-sm mb-3">
            Build a report
        </h2>

        <form asp-controller="Reports"
              asp-action="Generate"
              method="post"
              class="row g-3 align-items-end">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger small"></div>

            <div class="col-12 col-md-4">
                <label asp-for="ReportType"
                       class="form-label">
                    Report type
                </label>

                <select asp-for="ReportType"
                        class="form-select">
                    <option value="Safety incident summary">
                        Safety incident summary
                    </option>
                    <option value="Workforce headcount">
                        Workforce headcount
                    </option>
                    <option value="Leave register">
                        Leave register
                    </option>
                </select>

                <span asp-validation-for="ReportType"
                      class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-4">
                <label asp-for="BusinessUnit"
                       class="form-label">
                    Business unit
                </label>

                <select asp-for="BusinessUnit"
                        class="form-select">
                    <option value="All units">
                        All units
                    </option>
                    <option value="Mining Operations">
                        Mining Operations
                    </option>
                    <option value="Processing &amp; Logistics">
                        Processing &amp; Logistics
                    </option>
                    <option value="Corporate Services">
                        Corporate Services
                    </option>
                </select>
            </div>

            <div class="col-12 col-md-2">
                <label asp-for="Format"
                       class="form-label">
                    Export format
                </label>

                <select asp-for="Format"
                        class="form-select">
                    <option value="CSV">CSV</option>
                </select>
            </div>

            <div class="col-12 col-md-2">
                <button type="submit"
                        class="btn-ovl w-100">
                    <i class="fas fa-download me-1"></i>
                    Download
                </button>
            </div>
        </form>

        <p class="text-muted small mt-3 mb-0">
            Reports are generated from the connected
            backend database. CSV files can be opened
            using Microsoft Excel.
        </p>
    </div>
</div>

<h2 style="font-size:1.15rem;" class="mb-3">
    Available reports
</h2>

<div class="row g-3 mb-4">

    @foreach (var report in new[] {
        (
            "Workforce headcount",
            "Employee records, business units, job titles and status.",
            "fa-users",
            "#1E3A63"
        ),
        (
            "Leave register",
            "Employee leave requests, dates, duration and status.",
            "fa-calendar-check",
            "#2C5691"
        ),
        (
            "Safety incident summary",
            "Recorded safety incidents, severity, status and escalation.",
            "fa-helmet-safety",
            "#C0392B"
        )
    })
    {
        <div class="col-12 col-md-4">
            <div class="card h-100"
                 style="border-left:4px solid @report.Item4;">

                <div class="card-body p-4">
                    <i class="fas @report.Item3 mb-3"
                       style="color:@report.Item4;"></i>

                    <h3 style="font-size:.95rem;">
                        @report.Item1
                    </h3>

                    <p class="text-muted small">
                        @report.Item2
                    </p>

                    <span class="pill pill-muted">
                        CSV export
                    </span>
                </div>
            </div>
        </div>
    }
</div>

<div class="card">
    <div class="card-body p-4">
        <h2 style="font-size:1.05rem;">
            Report availability
        </h2>

        <p class="text-muted small mb-0">
            PDF and XLSX exports, supplier spend,
            ESG reporting and saved report history
            are not yet available.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
