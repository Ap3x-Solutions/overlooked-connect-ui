@model List<LeaveRequest>

@{
    ViewData["Title"] = "Leave Management";

    var filter =
        Context.Request.Query["status"].FirstOrDefault()
        ?? "All";

    var today = DateTime.Today;
    var monthStart = new DateTime(today.Year, today.Month, 1);

    var pendingCount =
        Model.Count(r =>
            r.ApprovalStatus.Equals(
                "Pending",
                StringComparison.OrdinalIgnoreCase));

    var approvedCount =
        Model.Count(r =>
            r.ApprovalStatus.Equals(
                "Approved",
                StringComparison.OrdinalIgnoreCase));

    var declinedCount =
        Model.Count(r =>
            r.ApprovalStatus.Equals(
                "Declined",
                StringComparison.OrdinalIgnoreCase));

    var totalCount = Model.Count;
}

<div class="page-head">
    <div>
        <h1>Leave Management</h1>

        <p class="sub">
            Live leave register
            &nbsp;&middot;&nbsp;
            @totalCount request@(totalCount == 1 ? "" : "s")
        </p>
    </div>

    <div class="d-flex gap-2">
        <a class="btn-ovl-ghost"
           asp-action="Roster">
            <i class="fas fa-calendar-days me-2"></i>
            Shift roster
        </a>
    </div>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="note note-ok mb-3">
        <i class="fas fa-circle-check me-2"></i>
        @successMessage
    </div>
}

@if (TempData["Error"] is string errorMessage)
{
    <div class="note note-bad mb-3">
        <i class="fas fa-circle-exclamation me-2"></i>
        @errorMessage
    </div>
}

<div class="row g-3 mb-4">

    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="label">
                Pending approval
            </div>

            <div class="value">
                @pendingCount
            </div>

            <div class="delta"
                 style="color:#E08E0B;">
                <span class="pip"
                      style="background:#E08E0B;">
                </span>

                Awaiting decision
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="label">
                Approved
            </div>

            <div class="value">
                @approvedCount
            </div>

            <div class="delta"
                 style="color:#1E6B3A;">
                <span class="pip"
                      style="background:#22A55B;">
                </span>

                Current register
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="label">
                Declined
            </div>

            <div class="value">
                @declinedCount
            </div>

            <div class="delta text-muted">
                <span class="pip"
                      style="background:#C0392B;">
                </span>

                Current register
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="label">
                Total requests
            </div>

            <div class="value">
                @totalCount
            </div>

            <div class="delta text-muted">
                <span class="pip"
                      style="background:#6C757D;">
                </span>

                Live API data
            </div>
        </div>
    </div>

</div>

<div class="chip-row">

    @foreach (var item in new[]
    {
        "All",
        "Pending",
        "Approved",
        "Declined"
    })
    {
        <a class="chip @(filter.Equals(
                item,
                StringComparison.OrdinalIgnoreCase)
                ? "active"
                : "")"
           asp-action="Index"
           asp-route-status="@item">

            @item
        </a>
    }

</div>

<div class="card">

    <div class="table-wrap">

        <table class="data-table">

            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Type</th>
                    <th>Dates</th>
                    <th>Days</th>
                    <th>Status</th>
                    <th style="width:220px;"></th>
                </tr>
            </thead>

            <tbody>

            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6"
                        class="text-center text-muted"
                        style="padding:2rem;">

                        No leave requests found.

                    </td>
                </tr>
            }
            else
            {
                @foreach (var r in Model)
                {
                    var statusClass =
                        r.ApprovalStatus.Equals(
                            "Approved",
                            StringComparison.OrdinalIgnoreCase)
                            ? "pill-ok"
                            : r.ApprovalStatus.Equals(
                                "Pending",
                                StringComparison.OrdinalIgnoreCase)
                                ? "pill-warn"
                                : "pill-bad";

                    <tr>

                        <td>
                            <div class="d-flex align-items-center gap-2">

                                <span class="avatar avatar-md"
                                      style="background-color:@r.AvatarColour;">
                                    @r.Initials
                                </span>

                                <span>
                                    <span class="t-strong">
                                        @r.EmployeeName
                                    </span>

                                    <span class="t-sub">
                                        @r.EmployeeId
                                    </span>
                                </span>

                            </div>
                        </td>

                        <td>
                            @r.LeaveType
                        </td>

                        <td>
                            @r.Dates
                        </td>

                        <td class="t-strong">
                            @r.Days.ToString("0.#")
                        </td>

                        <td>
                            <span class="pill @statusClass">
                                @r.ApprovalStatus
                            </span>
                        </td>

                        <td>

                            @if (r.ApprovalStatus.Equals(
                                "Pending",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="d-flex gap-2">

                                    <form asp-action="Approve"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@r.LeaveId" />

                                        <button type="submit"
                                                class="btn-ovl-green btn-sm-ovl">
                                            Approve
                                        </button>

                                    </form>

                                    <form asp-action="Decline"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@r.LeaveId" />

                                        <button type="submit"
                                                class="btn-ovl-red btn-sm-ovl">
                                            Decline
                                        </button>

                                    </form>

                                </div>
                            }
                            else
                            {
                                <span class="text-muted"
                                      style="font-size:.74rem;">
                                    Completed
                                </span>
                            }

                        </td>

                    </tr>
                }
            }

            </tbody>

        </table>

    </div>

</div>

<div class="note mt-3">
    <i class="fas fa-circle-info me-2"></i>
    Leave balances and roster conflicts are validated by the backend
    during the approval workflow.
</div>