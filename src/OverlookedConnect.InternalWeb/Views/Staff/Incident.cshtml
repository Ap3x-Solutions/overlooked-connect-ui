@model IncidentCaptureModel
@{
    ViewData["Title"] = "Report an Incident";
}

<div class="page-head">
    <div>
        <h1>Report an incident</h1>
        <p class="sub">Forzando South &middot; Section 4B &nbsp;&middot;&nbsp; captured as S. Dlamini (EMP-1042)</p>
    </div>
    <a class="btn-ovl-ghost" asp-action="Index"><i class="fas fa-arrow-left me-2"></i>Back to self-service</a>
</div>

<div class="note note-info mb-4">
    <i class="fas fa-clock me-2"></i>
    The report is timestamped by the server, not by this device, so the safety register cannot be
    altered by an incorrect device clock.
</div>

<form asp-action="Incident" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <div class="col-12 col-xl-7">
            <div class="card">
                <div class="card-body p-4">
                    <span class="card-title-sm d-block mb-1">Incident details</span>
                    <p class="text-muted" style="font-size:.74rem;">
                        Severity must be selected from the list &mdash; free text is not accepted.
                    </p>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-md-6">
                            <label asp-for="Severity" class="form-label">Severity *</label>
                            <select asp-for="Severity" class="form-select">
                                <option value="">Select severity…</option>
                                <option>Low</option>
                                <option>Medium</option>
                                <option selected>High</option>
                                <option>Fatal / LTI</option>
                            </select>
                            <span asp-validation-for="Severity" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="IncidentType" class="form-label">Incident type *</label>
                            <select asp-for="IncidentType" class="form-select">
                                <option>Equipment / guarding failure</option>
                                <option>Slip, trip or fall</option>
                                <option>Vehicle or mobile plant</option>
                                <option>Fall of ground</option>
                                <option>Near miss</option>
                            </select>
                            <span asp-validation-for="IncidentType" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Description *</label>
                            <textarea asp-for="Description" class="form-control" rows="4" maxlength="500"
                                      placeholder="Conveyor guard on CV-04 found detached during routine walk-through. Belt stopped and area barricaded. No injury sustained."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Photographic evidence</label>
                            <div class="d-flex gap-2 mb-2">
                                <div class="photo-tile" style="width:110px;height:80px;"></div>
                                <div class="photo-tile" style="width:110px;height:80px;background:linear-gradient(118deg,#3A5C8F,#6C8EBF);"></div>
                                <div class="photo-add" style="width:110px;height:80px;">
                                    <span><i class="fas fa-plus d-block text-center mb-1"></i>Add photo</span>
                                </div>
                            </div>
                            <input asp-for="Photos" type="file" class="form-control" multiple accept="image/*" />
                        </div>

                        <div class="col-12 col-md-8">
                            <label asp-for="Location" class="form-label">Location</label>
                            <input asp-for="Location" class="form-control" readonly />
                            <div class="form-text" style="font-size:.72rem;">Captured automatically from the device.</div>
                        </div>
                    </div>

                    <div class="note note-bad mt-4">
                        <i class="fas fa-circle-exclamation me-2"></i>
                        High severity escalates to the Safety Manager immediately and is reportable
                        to the Department of Mineral Resources and Energy.
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn-ovl" style="background-color:#C0392B;">Submit incident report</button>
                        <a class="btn-ovl-ghost" asp-action="Index">Cancel</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card h-100">
                <div class="card-body p-4">
                    <span class="card-title-sm d-block mb-3">What happens next</span>

                    <ul class="timeline mb-4">
                        <li><b style="font-size:.82rem;color:#0F1E3A;">Reported</b>
                            <span class="d-block text-muted" style="font-size:.74rem;">Reference issued immediately</span></li>
                        <li class="pending"><b style="font-size:.82rem;color:#0F1E3A;">Acknowledged</b>
                            <span class="d-block text-muted" style="font-size:.74rem;">Safety Officer confirms receipt</span></li>
                        <li class="pending"><b style="font-size:.82rem;color:#0F1E3A;">Under investigation</b>
                            <span class="d-block text-muted" style="font-size:.74rem;">Root cause established</span></li>
                        <li class="pending"><b style="font-size:.82rem;color:#0F1E3A;">Corrective action</b>
                            <span class="d-block text-muted" style="font-size:.74rem;">Owner and due date assigned</span></li>
                        <li class="pending"><b style="font-size:.82rem;color:#0F1E3A;">Verification &rarr; closed</b>
                            <span class="d-block text-muted" style="font-size:.74rem;">Ineffective actions return for rework</span></li>
                    </ul>

                    <div class="note note-warn mb-0">
                        <b style="display:block;">Working without signal?</b>
                        The report is queued on the device and synchronises when connectivity
                        returns. The original capture time is preserved.
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
