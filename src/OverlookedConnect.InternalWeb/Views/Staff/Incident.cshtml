@model IncidentCaptureModel
@{
    ViewData["Title"] = "Report Incident";
    Layout = "_StaffLayout";
}

<div class="phone-appbar">
    <div class="d-flex justify-content-between align-items-start">
        <div><h1>Report an incident</h1><div class="sub">Forzando South &middot; Section 4B</div></div>
        <span class="pill" style="background:#3A2E12;color:#D4A544;">OFFLINE</span>
    </div>
</div>

<div style="background:#152744;padding:12px 20px;color:#8FA0BE;font-size:.7rem;">
    Captured as S. Dlamini (EMP-1042) &middot; 22 Jul 09:41 &middot; timestamp set server-side
</div>

<div class="phone-body">
    <form asp-action="Incident" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()

        <label class="form-label">Severity *</label>
        <p class="text-muted" style="font-size:.68rem;margin-top:-4px;">Must be selected from the list &mdash; free text is not accepted.</p>
        <input type="hidden" asp-for="Severity" id="SeverityValue" />
        <div class="d-flex gap-2 flex-wrap mb-2">
            <span class="severity-chip" data-severity="Low" data-tone="on-low">Low</span>
            <span class="severity-chip" data-severity="Medium" data-tone="on-med">Medium</span>
            <span class="severity-chip on-high" data-severity="High" data-tone="on-high">High</span>
            <span class="severity-chip" data-severity="Fatal / LTI" data-tone="on-fatal">Fatal / LTI</span>
        </div>
        <span asp-validation-for="Severity" class="text-danger small"></span>

        <div class="note note-bad mb-3" id="severityWarning">
            High severity escalates to the Safety Manager immediately.
        </div>

        <label asp-for="IncidentType" class="form-label">Incident type *</label>
        <select asp-for="IncidentType" class="form-select mb-3">
            <option>Equipment / guarding failure</option><option>Slip, trip or fall</option>
            <option>Vehicle or mobile plant</option><option>Fall of ground</option><option>Near miss</option>
        </select>
        <span asp-validation-for="IncidentType" class="text-danger small"></span>

        <label asp-for="Description" class="form-label">Description *</label>
        <textarea asp-for="Description" class="form-control mb-1" rows="4" maxlength="500" data-counter="descCount"
                  placeholder="Conveyor guard on CV-04 found detached during routine walk-through. Belt stopped and area barricaded. No injury sustained."></textarea>
        <div class="text-muted mb-3" style="font-size:.68rem;"><span id="descCount">0 / 500</span></div>
        <span asp-validation-for="Description" class="text-danger small"></span>

        <label class="form-label">Photographic evidence</label>
        <p class="text-muted" style="font-size:.68rem;margin-top:-4px;">Captured from the device camera &mdash; 2 attached</p>
        <div class="row g-2 mb-3">
            <div class="col-4"><div class="photo-tile"></div></div>
            <div class="col-4"><div class="photo-tile" style="background:linear-gradient(118deg,#3A5C8F,#6C8EBF);"></div></div>
            <div class="col-4">
                <label class="photo-add w-100 mb-0" for="Photos"><span><i class="fas fa-plus d-block text-center mb-1"></i>Add photo</span></label>
                <input asp-for="Photos" type="file" id="Photos" multiple accept="image/*" class="d-none" />
            </div>
        </div>

        <label class="form-label">Location</label>
        <div class="card mb-3"><div class="card-body p-3 d-flex align-items-center gap-3">
            <span class="d-grid" style="width:32px;height:32px;border-radius:50%;background:#22A55B;place-items:center;color:#fff;"><i class="fas fa-location-crosshairs" style="font-size:.75rem;"></i></span>
            <span style="font-size:.78rem;"><b>GPS captured automatically</b><span class="d-block text-muted" style="font-size:.68rem;">@Model.Location</span></span>
        </div></div>

        <div class="note note-warn mb-3">
            <i class="fas fa-flag me-2"></i>
            No signal &mdash; this report will sync automatically when connectivity returns. Capture time is preserved.
        </div>

        <button type="submit" class="btn-ovl w-100 mb-2" style="background-color:#C0392B;padding:14px;">Submit incident report</button>
        <a class="btn-ovl-ghost w-100 d-block text-center" asp-action="Index">Save as draft</a>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
