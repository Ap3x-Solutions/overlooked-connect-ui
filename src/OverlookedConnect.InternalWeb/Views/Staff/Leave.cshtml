@model StaffLeaveRequestModel
@{
    ViewData["Title"] = "Request Leave";
    Layout = "_StaffLayout";
}

<div class="phone-appbar">
    <div class="d-flex justify-content-between align-items-start">
        <div><h1>Request leave</h1><div class="sub">S. Dlamini &middot; EMP-1042</div></div>
        <a asp-action="Index" style="color:#fff;font-size:1.1rem;"><i class="fas fa-arrow-left"></i></a>
    </div>
</div>

<div class="phone-body">
    <div class="card mb-3"><div class="card-body p-3 d-flex text-center">
        <div class="flex-fill"><div style="font-size:1.2rem;font-weight:800;color:#22A55B;">12.5 d</div><div class="text-muted" style="font-size:.68rem;">Available</div></div>
        <div class="flex-fill border-start border-end"><div style="font-size:1.2rem;font-weight:800;color:#E08E0B;">5.0 d</div><div class="text-muted" style="font-size:.68rem;">Pending</div></div>
        <div class="flex-fill"><div style="font-size:1.2rem;font-weight:800;color:#5B6675;">9.5 d</div><div class="text-muted" style="font-size:.68rem;">Taken 2026</div></div>
    </div></div>

    <form asp-action="Leave" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()

        <label class="form-label">Leave type *</label>
        <select asp-for="LeaveType" class="form-select mb-3">
            <option>Annual</option><option>Sick</option><option>Family responsibility</option><option>Study</option>
        </select>
        <span asp-validation-for="LeaveType" class="text-danger small"></span>

        <div class="row g-2 mb-3">
            <div class="col-6">
                <label asp-for="StartDate" class="form-label">From *</label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="EndDate" class="form-label">To *</label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="note note-info mb-3">5 working days will be deducted from your balance.</div>

        <div class="note note-warn mb-3">
            <b style="display:block;">Roster clash detected</b>
            You are rostered for day shift on 14 and 15 August. HR will need to arrange cover before approving.
        </div>

        <label asp-for="Reason" class="form-label">Reason (optional)</label>
        <textarea asp-for="Reason" class="form-control mb-1" rows="3" maxlength="500" data-counter="reasonCount" placeholder="Family commitment in Nelspruit."></textarea>
        <div class="text-muted mb-3" style="font-size:.68rem;"><span id="reasonCount">0 / 500</span></div>

        <label asp-for="SupportingDocument" class="form-label">Supporting document</label>
        <input asp-for="SupportingDocument" type="file" class="form-control mb-1" id="LeaveDoc" />
        <div class="text-muted mb-3" style="font-size:.68rem;" data-file-for="LeaveDoc">Optional for annual leave</div>

        <label class="form-label">Approval route</label>
        <div class="card mb-3"><div class="card-body p-3 d-flex gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="avatar avatar-sm" style="background-color:#1E6B3A;">NS</span>
                <span style="font-size:.74rem;"><b>N. Sithole</b><span class="d-block text-muted" style="font-size:.66rem;">First approver</span></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="avatar avatar-sm" style="background-color:#2C4A7A;">TM</span>
                <span style="font-size:.74rem;"><b>T. Mahlangu</b><span class="d-block text-muted" style="font-size:.66rem;">Notified</span></span>
            </div>
        </div></div>

        <button type="submit" class="btn-ovl w-100 mb-2" style="padding:14px;">Submit request</button>
        <a class="btn-ovl-ghost w-100 d-block text-center" asp-action="Index">Save as draft</a>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
