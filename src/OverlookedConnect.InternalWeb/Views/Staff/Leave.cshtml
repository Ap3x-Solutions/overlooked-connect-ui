@model StaffLeaveRequestModel
@{
    ViewData["Title"] = "Request Leave";
}

<div class="page-head">
    <div>
        <h1>Request leave</h1>
        <p class="sub">S. Dlamini &middot; EMP-1042 &nbsp;&middot;&nbsp; Mining Operations</p>
    </div>
    <a class="btn-ovl-ghost" asp-action="Index"><i class="fas fa-arrow-left me-2"></i>Back to self-service</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-4"><div class="stat-card"><div class="label">Available</div><div class="value" style="color:#22A55B;">12.5<span style="font-size:1rem;"> d</span></div></div></div>
    <div class="col-4"><div class="stat-card"><div class="label">Pending approval</div><div class="value" style="color:#E08E0B;">5.0<span style="font-size:1rem;"> d</span></div></div></div>
    <div class="col-4"><div class="stat-card"><div class="label">Taken in 2026</div><div class="value">9.5<span style="font-size:1rem;"> d</span></div></div></div>
</div>

<form asp-action="Leave" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <div class="col-12 col-xl-7">
            <div class="card">
                <div class="card-body p-4">
                    <span class="card-title-sm d-block mb-3">Request details</span>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="LeaveType" class="form-label">Leave type *</label>
                            <select asp-for="LeaveType" class="form-select">
                                <option>Annual</option>
                                <option>Sick</option>
                                <option>Family responsibility</option>
                                <option>Study</option>
                            </select>
                            <span asp-validation-for="LeaveType" class="text-danger small"></span>
                        </div>

                        <div class="col-6 col-md-3">
                            <label asp-for="StartDate" class="form-label">From *</label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>

                        <div class="col-6 col-md-3">
                            <label asp-for="EndDate" class="form-label">To *</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Reason" class="form-label">Reason (optional)</label>
                            <textarea asp-for="Reason" class="form-control" rows="3" maxlength="500"
                                      placeholder="Family commitment in Nelspruit."></textarea>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="SupportingDocument" class="form-label">Supporting document</label>
                            <input asp-for="SupportingDocument" type="file" class="form-control" />
                            <div class="form-text" style="font-size:.72rem;">Required for sick leave over two days.</div>
                        </div>
                    </div>

                    <div class="note note-info mt-4">
                        5 working days will be deducted from your balance, leaving 7.5 days.
                    </div>

                    <div class="note note-warn mt-3">
                        <b style="display:block;">Roster clash detected</b>
                        You are rostered for day shift on 14 and 15 August. HR will need to arrange
                        cover before this request can be approved.
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn-ovl">Submit request</button>
                        <a class="btn-ovl-ghost" asp-action="Index">Cancel</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card h-100">
                <div class="card-body p-4">
                    <span class="card-title-sm d-block mb-3">Approval route</span>

                    <ul class="timeline mb-4">
                        <li class="pending">
                            <b style="font-size:.82rem;color:#0F1E3A;">N. Sithole</b>
                            <span class="d-block text-muted" style="font-size:.74rem;">HR &amp; Operations &middot; first approver</span>
                        </li>
                        <li class="pending">
                            <b style="font-size:.82rem;color:#0F1E3A;">T. Mahlangu</b>
                            <span class="d-block text-muted" style="font-size:.74rem;">Executive &middot; notified</span>
                        </li>
                    </ul>

                    <span class="card-title-sm d-block mb-2">Your leave history</span>
                    <div class="d-flex justify-content-between py-2 border-bottom" style="font-size:.8rem;">
                        <span>28&ndash;29 Jul &middot; Sick</span><span class="pill pill-ok">Approved</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom" style="font-size:.8rem;">
                        <span>05 Aug &middot; Family resp.</span><span class="pill pill-ok">Approved</span>
                    </div>
                    <div class="d-flex justify-content-between py-2" style="font-size:.8rem;">
                        <span>14&ndash;18 Aug &middot; Annual</span><span class="pill pill-warn">Pending</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
