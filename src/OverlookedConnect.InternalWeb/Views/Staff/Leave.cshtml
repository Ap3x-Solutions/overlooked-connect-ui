@model StaffLeaveRequestModel

@{
    ViewData["Title"] = "Request Leave";

    var employeeName =
        Context.Session.GetString("UserName") ?? "Employee";

    var employeeNumber =
        Context.Session.GetString("EmployeeNumber") ?? "";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

    <div>
        <h1 style="
            margin:0;
            color:#0F1E3A;
            font-size:1.45rem;
            font-weight:800;">
            Request Leave
        </h1>

        <div class="text-muted mt-1"
             style="font-size:.8rem;">
            Submit a new leave request to Human Resources
        </div>
    </div>

    <a asp-controller="Staff"
       asp-action="Index"
       class="btn-ovl-ghost text-decoration-none">

        <i class="fas fa-arrow-left me-2"></i>
        Back to dashboard

    </a>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-4"
         role="alert">

        <i class="fas fa-circle-check me-2"></i>
        @TempData["SuccessMessage"]

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning mb-4"
         role="alert">

        <i class="fas fa-triangle-exclamation me-2"></i>
        @TempData["Error"]

    </div>
}


<div class="row g-4">

    <!-- LEFT: LEAVE FORM -->
    <div class="col-12 col-xl-8">

        <div class="card">

            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3 mb-4">

                    <span class="d-grid"
                          style="
                            width:46px;
                            height:46px;
                            min-width:46px;
                            border-radius:10px;
                            background:#E8EEF8;
                            place-items:center;
                            color:#2C5691;">

                        <i class="fas fa-calendar-check"
                           style="font-size:1.15rem;"></i>

                    </span>

                    <div>

                        <div class="card-title-sm">
                            Leave request details
                        </div>

                        <div class="text-muted mt-1"
                             style="font-size:.74rem;">
                            Complete the form below and submit it for review.
                        </div>

                    </div>

                </div>


                <form asp-controller="Staff"
                      asp-action="Leave"
                      method="post"
                      enctype="multipart/form-data"
                      class="needs-validation"
                      novalidate>

                    @Html.AntiForgeryToken()


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger small mb-3">
                    </div>


                    <div class="mb-3">

                        <label asp-for="LeaveType"
                               class="form-label">
                            Leave type *
                        </label>

                        <select asp-for="LeaveType"
                                class="form-select">

                            <option value="Annual">Annual</option>
                            <option value="Sick">Sick</option>
                            <option value="Family responsibility">
                                Family responsibility
                            </option>
                            <option value="Study">Study</option>

                        </select>

                        <span asp-validation-for="LeaveType"
                              class="text-danger small">
                        </span>

                    </div>


                    <div class="row g-3 mb-3">

                        <div class="col-12 col-md-6">

                            <label asp-for="StartDate"
                                   class="form-label">
                                From *
                            </label>

                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="StartDate"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="col-12 col-md-6">

                            <label asp-for="EndDate"
                                   class="form-label">
                                To *
                            </label>

                            <input asp-for="EndDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="EndDate"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Reason"
                               class="form-label">
                            Reason
                            <span class="text-muted"
                                  style="font-weight:400;">
                                (optional)
                            </span>
                        </label>

                        <textarea asp-for="Reason"
                                  class="form-control"
                                  rows="5"
                                  maxlength="500"
                                  id="Reason"
                                  placeholder="Provide any additional information that may help HR review your request."></textarea>

                        <div class="d-flex justify-content-between mt-1">

                            <span asp-validation-for="Reason"
                                  class="text-danger small">
                            </span>

                            <span id="reasonCount"
                                  class="text-muted"
                                  style="font-size:.68rem;">
                                0 / 500
                            </span>

                        </div>

                    </div>


                    <div class="mb-4">

                        <label asp-for="SupportingDocument"
                               class="form-label">
                            Supporting document
                        </label>

                        <input asp-for="SupportingDocument"
                               type="file"
                               class="form-control"
                               id="LeaveDoc" />

                        <div class="text-muted mt-2"
                             style="font-size:.7rem;">

                            Add a supporting document where applicable.

                        </div>

                    </div>


                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn-ovl"
                                style="min-width:180px;">

                            <i class="fas fa-paper-plane me-2"></i>
                            Submit request

                        </button>

                        <a asp-controller="Staff"
                           asp-action="Index"
                           class="btn-ovl-ghost text-decoration-none">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <!-- RIGHT: INFORMATION -->
    <div class="col-12 col-xl-4">

        <div class="card mb-3">

            <div class="card-body p-4">

                <div class="card-title-sm mb-3">
                    Employee
                </div>


                <div class="d-flex align-items-center gap-3">

                    <span class="avatar avatar-md"
                          style="background-color:#0F1E3A;">

                        @{
                            var initials =
                                Context.Session.GetString("UserInitials") ?? "E";
                        }

                        @initials

                    </span>


                    <div>

                        <div style="
                            font-size:.82rem;
                            font-weight:700;
                            color:#0F1E3A;">

                            @employeeName

                        </div>


                        @if (!string.IsNullOrWhiteSpace(employeeNumber))
                        {
                            <div class="text-muted mt-1"
                                 style="font-size:.7rem;">

                                @employeeNumber

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>


        <div class="card">

            <div class="card-body p-4">

                <div class="card-title-sm mb-3">
                    What happens next?
                </div>


                <div class="d-flex gap-3 mb-3">

                    <span class="d-grid"
                          style="
                            width:34px;
                            height:34px;
                            min-width:34px;
                            border-radius:50%;
                            background:#E8EEF8;
                            color:#2C5691;
                            place-items:center;
                            font-weight:800;
                            font-size:.75rem;">
                        1
                    </span>

                    <div>

                        <div style="
                            font-size:.78rem;
                            font-weight:700;
                            color:#0F1E3A;">
                            Submit request
                        </div>

                        <div class="text-muted mt-1"
                             style="font-size:.7rem;">
                            Your leave request is securely sent to Overlooked Connect.
                        </div>

                    </div>

                </div>


                <div class="d-flex gap-3 mb-3">

                    <span class="d-grid"
                          style="
                            width:34px;
                            height:34px;
                            min-width:34px;
                            border-radius:50%;
                            background:#FFF4DB;
                            color:#A86B00;
                            place-items:center;
                            font-weight:800;
                            font-size:.75rem;">
                        2
                    </span>

                    <div>

                        <div style="
                            font-size:.78rem;
                            font-weight:700;
                            color:#0F1E3A;">
                            HR review
                        </div>

                        <div class="text-muted mt-1"
                             style="font-size:.7rem;">
                            Human Resources reviews the dates and request details.
                        </div>

                    </div>

                </div>


                <div class="d-flex gap-3">

                    <span class="d-grid"
                          style="
                            width:34px;
                            height:34px;
                            min-width:34px;
                            border-radius:50%;
                            background:#E7F6ED;
                            color:#1E7D46;
                            place-items:center;
                            font-weight:800;
                            font-size:.75rem;">
                        3
                    </span>

                    <div>

                        <div style="
                            font-size:.78rem;
                            font-weight:700;
                            color:#0F1E3A;">
                            Status update
                        </div>

                        <div class="text-muted mt-1"
                             style="font-size:.7rem;">
                            The request will be marked pending, approved, or declined.
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const reason =
                document.getElementById("Reason");

            const counter =
                document.getElementById("reasonCount");

            function updateReasonCounter() {

                if (!reason || !counter) {
                    return;
                }

                counter.textContent =
                    `${reason.value.length} / 500`;
            }

            if (reason) {

                reason.addEventListener(
                    "input",
                    updateReasonCounter);

                updateReasonCounter();
            }
        });
    </script>
}