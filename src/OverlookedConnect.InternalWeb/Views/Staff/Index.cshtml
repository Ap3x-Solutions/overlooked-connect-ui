@model OverlookedConnect.Internal.Models.StaffHomeViewModel

@{
    ViewData["Title"] = "Employee Dashboard";

    var userName = Context.Session.GetString("UserName") ?? "Employee";
    var employeeNumber = Context.Session.GetString("EmployeeNumber");

    var firstName = userName.Split(
        ' ',
        StringSplitOptions.RemoveEmptyEntries
    ).FirstOrDefault() ?? "Employee";

    var today = DateTime.Today;

    var upcomingShifts = Model.Shifts
        .Where(s => s.ShiftDate.Date >= today)
        .OrderBy(s => s.ShiftDate)
        .Take(5)
        .ToList();

    var nextShift = upcomingShifts.FirstOrDefault();

    string ShiftClass(string shiftType) =>
        shiftType switch
        {
            "Day" => "pill-ok",
            "Night" => "pill-info",
            "Leave" => "pill-warn",
            _ => "pill-neutral"
        };
}

<div class="page-head">
    <div>
        <h1>Good morning, @firstName</h1>

        <p class="sub">
            Employee portal

            @if (!string.IsNullOrWhiteSpace(employeeNumber))
            {
                <span>&nbsp;&middot;&nbsp; @employeeNumber</span>
            }
        </p>
    </div>

    <span class="pill pill-ok">
        <i class="fas fa-circle me-1" style="font-size:.45rem;"></i>
        Employee
    </span>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning mb-4" role="alert">
        <i class="fas fa-triangle-exclamation me-2"></i>
        @TempData["Error"]
    </div>
}



<div class="row g-3 mb-4">

    <div class="col-12 col-md-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="label">Upcoming shifts</div>

            <div class="value">
                @upcomingShifts.Count
            </div>

            <div class="delta" style="color:#1E6B3A;">
                <span class="pip" style="background:#22A55B;"></span>
                From your live schedule
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="label">Next shift</div>

            @if (nextShift != null)
            {
                <div class="value" style="font-size:1.35rem;">
                    @nextShift.ShiftType
                </div>

                <div class="delta">
                    <span class="pip" style="background:#D4A544;"></span>
                    @nextShift.ShiftDate.ToString("ddd, dd MMM")
                </div>
            }
            else
            {
                <div class="value" style="font-size:1.35rem;">
                    —
                </div>

                <div class="delta text-muted">
                    No upcoming shift
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="label">Leave</div>

            <div class="value" style="font-size:1.35rem;">
                Requests
            </div>

            <div class="delta text-muted">
                View or submit leave requests
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="label">Safety</div>

            <div class="value" style="font-size:1.35rem;">
                Incidents
            </div>

            <div class="delta text-muted">
                Report workplace incidents
            </div>
        </div>
    </div>

</div>

<div class="row g-3 mb-4">

    <div class="col-12 col-xl-8">
        <div class="card h-100">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <div class="card-title-sm">
                            My upcoming shifts
                        </div>

                        <div class="text-muted mt-1"
                             style="font-size:.74rem;">
                            Schedule retrieved from Overlooked Connect
                        </div>
                    </div>

                    <span class="pill pill-ok">
                        LIVE
                    </span>
                </div>

                @if (upcomingShifts.Count > 0)
                {
                    <div class="table-wrap">
                        <table class="data-table">

                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Day</th>
                                    <th>Shift</th>
                                    <th>Site</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var shift in upcomingShifts)
                                {
                                    <tr>
                                        <td class="t-strong">
                                            @shift.ShiftDate.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            @shift.ShiftDate.ToString("dddd")
                                        </td>

                                        <td>
                                            <span class="pill @ShiftClass(shift.ShiftType)">
                                                @shift.ShiftType
                                            </span>
                                        </td>

                                        <td>
                                            @shift.Site
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">

                        <i class="fas fa-calendar-days text-muted mb-3"
                           style="font-size:2rem;"></i>

                        <div style="font-weight:700;color:#0F1E3A;">
                            No upcoming shifts
                        </div>

                        <div class="text-muted mt-1"
                             style="font-size:.78rem;">
                            There are currently no future shifts in your schedule.
                        </div>

                    </div>
                }

            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card h-100">

            <div class="card-body p-4">

                <div class="card-title-sm mb-4">
                    Quick actions
                </div>

                <a asp-controller="Staff"
                   asp-action="Leave"
                   class="d-flex align-items-center gap-3 text-decoration-none border-bottom pb-3 mb-3">

                    <span class="d-grid"
                          style="
                            width:42px;
                            height:42px;
                            min-width:42px;
                            border-radius:9px;
                            background:#2C5691;
                            place-items:center;
                            color:#fff;">

                        <i class="fas fa-calendar-check"></i>

                    </span>

                    <span>
                        <span style="
                            display:block;
                            font-size:.82rem;
                            font-weight:700;
                            color:#0F1E3A;">

                            Request leave

                        </span>

                        <span class="text-muted"
                              style="font-size:.7rem;">

                            Submit or view your leave requests

                        </span>
                    </span>

                    <i class="fas fa-chevron-right ms-auto text-muted"></i>

                </a>

                <a asp-controller="Staff"
                   asp-action="Incident"
                   class="d-flex align-items-center gap-3 text-decoration-none border-bottom pb-3 mb-3">

                    <span class="d-grid"
                          style="
                            width:42px;
                            height:42px;
                            min-width:42px;
                            border-radius:9px;
                            background:#C0392B;
                            place-items:center;
                            color:#fff;">

                        <i class="fas fa-triangle-exclamation"></i>

                    </span>

                    <span>
                        <span style="
                            display:block;
                            font-size:.82rem;
                            font-weight:700;
                            color:#0F1E3A;">

                            Report incident

                        </span>

                        <span class="text-muted"
                              style="font-size:.7rem;">

                            Report a workplace safety incident

                        </span>
                    </span>

                    <i class="fas fa-chevron-right ms-auto text-muted"></i>

                </a>

                <a asp-controller="Staff"
                   asp-action="Payslip"
                   class="d-flex align-items-center gap-3 text-decoration-none">

                    <span class="d-grid"
                          style="
                            width:42px;
                            height:42px;
                            min-width:42px;
                            border-radius:9px;
                            background:#22A55B;
                            place-items:center;
                            color:#fff;">

                        <i class="fas fa-file-invoice-dollar"></i>

                    </span>

                    <span>
                        <span style="
                            display:block;
                            font-size:.82rem;
                            font-weight:700;
                            color:#0F1E3A;">

                            Payslip

                        </span>

                        <span class="text-muted"
                              style="font-size:.7rem;">

                            View your payslip

                        </span>
                    </span>

                    <i class="fas fa-chevron-right ms-auto text-muted"></i>

                </a>

            </div>
        </div>
    </div>

</div>

<div class="row g-3">

    <div class="col-12 col-xl-8">

        <div class="card">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>
                        <div class="card-title-sm">
                            Employee services
                        </div>

                        <div class="text-muted mt-1"
                             style="font-size:.74rem;">
                            Access your Overlooked Connect employee services
                        </div>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-12 col-md-4">

                        <a asp-controller="Staff"
                           asp-action="Leave"
                           class="card d-block h-100 text-decoration-none">

                            <div class="card-body p-3">

                                <i class="fas fa-calendar-check mb-3"
                                   style="font-size:1.25rem;color:#2C5691;"></i>

                                <div style="
                                    font-size:.82rem;
                                    font-weight:700;
                                    color:#0F1E3A;">

                                    Leave

                                </div>

                                <div class="text-muted mt-1"
                                     style="font-size:.7rem;">

                                    Manage leave requests

                                </div>

                            </div>
                        </a>

                    </div>

                    <div class="col-12 col-md-4">

                        <a asp-controller="Staff"
                           asp-action="Incident"
                           class="card d-block h-100 text-decoration-none">

                            <div class="card-body p-3">

                                <i class="fas fa-shield-halved mb-3"
                                   style="font-size:1.25rem;color:#C0392B;"></i>

                                <div style="
                                    font-size:.82rem;
                                    font-weight:700;
                                    color:#0F1E3A;">

                                    Safety

                                </div>

                                <div class="text-muted mt-1"
                                     style="font-size:.7rem;">

                                    Report an incident

                                </div>

                            </div>
                        </a>

                    </div>

                    <div class="col-12 col-md-4">

                        <a asp-controller="Staff"
                           asp-action="Payslip"
                           class="card d-block h-100 text-decoration-none">

                            <div class="card-body p-3">

                                <i class="fas fa-file-invoice-dollar mb-3"
                                   style="font-size:1.25rem;color:#22A55B;"></i>

                                <div style="
                                    font-size:.82rem;
                                    font-weight:700;
                                    color:#0F1E3A;">

                                    Payslip

                                </div>

                                <div class="text-muted mt-1"
                                     style="font-size:.7rem;">

                                    View payroll documents

                                </div>

                            </div>
                        </a>

                    </div>

                </div>

            </div>
        </div>

    </div>

    <div class="col-12 col-xl-4">

        <div class="card h-100">

            <div class="card-body p-4">

                <div class="card-title-sm mb-3">
                    Account
                </div>

                <div class="d-flex align-items-center gap-3 mb-3">

                    <span class="avatar avatar-md"
                          style="background-color:#0F1E3A;">

                        @{
                            var initials = Context.Session.GetString("UserInitials") ?? "E";
                        }

                        @initials

                    </span>

                    <div>

                        <div style="
                            font-size:.82rem;
                            font-weight:700;
                            color:#0F1E3A;">

                            @userName

                        </div>

                        <div class="text-muted"
                             style="font-size:.7rem;">

                            Employee

                        </div>

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(employeeNumber))
                {
                    <div class="border-top pt-3"
                         style="font-size:.76rem;">

                        <div class="text-muted mb-1">
                            Employee number
                        </div>

                        <strong>
                            @employeeNumber
                        </strong>

                    </div>
                }

            </div>
        </div>

    </div>

</div>