@{
    ViewData["Title"] = "Employee Self-Service";
    var userName = Context.Session.GetString("UserName") ?? "Sipho Dlamini";
    var firstName = userName.Split(' ').First();
}

<div class="page-head">
    <div>
        <h1>Employee Self-Service</h1>
        <p class="sub">@userName &nbsp;&middot;&nbsp; EMP-1042 &nbsp;&middot;&nbsp; Forzando South, Section 4B</p>
    </div>
    <form asp-action="ClockOut" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-ovl" style="background-color:#C0392B;">
            <i class="fas fa-right-from-bracket me-2"></i>Clock out
        </button>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-xl-5">
        <div class="card h-100" style="background:linear-gradient(118deg,#0F1E3A,#254070);border:0;">
            <div class="card-body p-4">
                <div style="font-size:.62rem;font-weight:700;letter-spacing:1.4px;color:#D4A544;">CURRENTLY</div>
                <div style="font-size:1.85rem;font-weight:800;color:#fff;margin-top:6px;">Clocked in</div>
                <div style="font-size:.8rem;color:#C6D2E6;margin-top:6px;">Since 06:02 &nbsp;&middot;&nbsp; 3 h 39 m on shift</div>
                <div style="font-size:.74rem;color:#8FA0BE;margin-top:12px;">
                    <span class="d-inline-block me-2" style="width:9px;height:9px;border-radius:50%;background:#22A55B;"></span>
                    Day shift &middot; ends 18:00
                </div>
                <p class="mb-0 mt-3" style="font-size:.7rem;color:#7E8FAC;">
                    Location is captured when you clock in and out.
                </p>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-2">
        <div class="stat-card h-100">
            <div class="label">Hours this week</div><div class="value">38.5</div>
            <div class="delta" style="color:#1E6B3A;"><span class="pip" style="background:#22A55B;"></span>2.5 h overtime</div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="stat-card h-100">
            <div class="label">Shifts completed</div><div class="value">4<span style="font-size:1rem;"> of 5</span></div>
            <div class="delta" style="color:#1E6B3A;"><span class="pip" style="background:#22A55B;"></span>on schedule</div>
        </div>
    </div>
    <div class="col-12 col-xl-3">
        <div class="stat-card h-100">
            <div class="label">Leave balance</div><div class="value">12.5<span style="font-size:1rem;"> days</span></div>
            <div class="delta" style="color:#E08E0B;"><span class="pip" style="background:#E08E0B;"></span>5.0 days pending approval</div>
        </div>
    </div>
</div>

<h2 style="font-size:1.15rem;" class="mb-3">Quick actions</h2>
<div class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none d-block" asp-action="Leave">
            <div class="card-body p-4">
                <span class="d-grid" style="width:38px;height:38px;border-radius:8px;background:#2C5691;place-items:center;color:#fff;">
                    <i class="fas fa-calendar-check"></i>
                </span>
                <h3 style="font-size:.95rem;margin-top:14px;">Request leave</h3>
                <p class="text-muted mb-0" style="font-size:.76rem;">12.5 days available</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none d-block" asp-action="Incident">
            <div class="card-body p-4">
                <span class="d-grid" style="width:38px;height:38px;border-radius:8px;background:#C0392B;place-items:center;color:#fff;">
                    <i class="fas fa-triangle-exclamation"></i>
                </span>
                <h3 style="font-size:.95rem;margin-top:14px;">Report an incident</h3>
                <p class="text-muted mb-0" style="font-size:.76rem;">Attach photographic evidence</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none d-block" asp-action="Payslip">
            <div class="card-body p-4">
                <span class="d-grid" style="width:38px;height:38px;border-radius:8px;background:#22A55B;place-items:center;color:#fff;">
                    <i class="fas fa-file-invoice-dollar"></i>
                </span>
                <h3 style="font-size:.95rem;margin-top:14px;">View payslip</h3>
                <p class="text-muted mb-0" style="font-size:.76rem;">July 2026 available</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none d-block" asp-controller="Leave" asp-action="Roster">
            <div class="card-body p-4">
                <span class="d-grid" style="width:38px;height:38px;border-radius:8px;background:#D4A544;place-items:center;color:#0F1E3A;">
                    <i class="fas fa-clock"></i>
                </span>
                <h3 style="font-size:.95rem;margin-top:14px;">My shifts</h3>
                <p class="text-muted mb-0" style="font-size:.76rem;">Next: Tue 12 Aug, day</p>
            </div>
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-7">
        <div class="card h-100">
            <div class="card-body p-4">
                <span class="card-title-sm d-block mb-3">Recent activity</span>

                <ul class="timeline mb-0">
                    <li class="pending">
                        <b style="font-size:.82rem;color:#0F1E3A;">Leave request submitted</b>
                        <span class="d-block text-muted" style="font-size:.74rem;">
                            14&ndash;18 August &middot; Annual &middot; 5 days &middot; awaiting N. Sithole
                        </span>
                    </li>
                    <li>
                        <b style="font-size:.82rem;color:#0F1E3A;">Incident reported &mdash; INC-1042</b>
                        <span class="d-block text-muted" style="font-size:.74rem;">
                            22 July &middot; Conveyor guard detached &middot; under investigation
                        </span>
                    </li>
                    <li>
                        <b style="font-size:.82rem;color:#0F1E3A;">Payslip issued</b>
                        <span class="d-block text-muted" style="font-size:.74rem;">
                            25 July &middot; July 2026 &middot; R 24 318.42
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-5">
        <div class="card h-100">
            <div class="card-body p-4">
                <span class="card-title-sm d-block mb-3">Outstanding</span>

                <div class="note note-warn mb-3">
                    <b style="display:block;">Safety toolbox talk</b>
                    Conveyor guarding &mdash; 15 minutes, due before your next shift.
                </div>

                <div class="note note-info mb-0">
                    <b style="display:block;">Roster clash on your leave request</b>
                    You are rostered for day shift on 14 and 15 August. HR is arranging cover.
                </div>
            </div>
        </div>
    </div>
</div>
