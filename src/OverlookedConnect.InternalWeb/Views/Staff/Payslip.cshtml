@{
    ViewData["Title"] = "My Payslip";
    Layout = "_StaffLayout";
}

<div class="phone-appbar">
    <div class="d-flex justify-content-between align-items-start">
        <div><h1>My payslips</h1><div class="sub">S. Dlamini &middot; EMP-1042</div></div>
        <a asp-action="Index" style="color:#fff;font-size:1.1rem;"><i class="fas fa-arrow-left"></i></a>
    </div>
</div>

<div style="background:#172C52;padding:12px 20px;display:flex;justify-content:space-between;align-items:center;">
    <span style="color:#fff;font-size:.82rem;font-weight:600;">July 2026 <i class="fas fa-chevron-down ms-2" style="color:#D4A544;font-size:.7rem;"></i></span>
    <span style="color:#8FA0BE;font-size:.7rem;">Paid 25 Jul 2026</span>
</div>

<div style="background:linear-gradient(118deg,#0F1E3A,#254070);color:#fff;padding:24px 20px;">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <div style="font-size:.62rem;font-weight:700;letter-spacing:1.4px;color:#D4A544;">NET PAY</div>
            <div style="font-size:2rem;font-weight:800;margin-top:6px;">R 24 318.42</div>
            <div style="font-size:.74rem;color:#C6D2E6;margin-top:6px;">Standard Bank &middot;&middot;&middot;&middot; 4471</div>
        </div>
        <span class="pill" style="background:#1E6B3A;color:#fff;">PAID</span>
    </div>
</div>

<div class="phone-body">
    <h2 style="font-size:1rem;" class="mb-2">Earnings</h2>
    <div class="card mb-3"><div class="card-body p-3">
        <div class="d-flex justify-content-between py-2 border-bottom" style="font-size:.8rem;"><span class="text-muted">Basic salary</span><b>R 28 400.00</b></div>
        <div class="d-flex justify-content-between py-2 border-bottom" style="font-size:.8rem;"><span class="text-muted">Shift allowance</span><b>R 2 840.00</b></div>
        <div class="d-flex justify-content-between py-2 border-bottom" style="font-size:.8rem;"><span class="text-muted">Overtime (2.5 h)</span><b>R 1 065.00</b></div>
        <div class="d-flex justify-content-between py-2 border-bottom" style="font-size:.8rem;"><span class="text-muted">Underground allowance</span><b>R 1 200.00</b></div>
        <div class="d-flex justify-content-between pt-2" style="font-size:.85rem;"><b>Gross</b><b>R 33 505.00</b></div>
    </div></div>

    <h2 style="font-size:1rem;" class="mb-2">Deductions</h2>
    <div class="card mb-3"><div class="card-body p-3">
        <div class="d-flex justify-content-between py-2 border-bottom" style="font-size:.8rem;"><span class="text-muted">PAYE</span><b style="color:#C0392B;">R 6 218.58</b></div>
        <div class="d-flex justify-content-between py-2 border-bottom" style="font-size:.8rem;"><span class="text-muted">UIF</span><b style="color:#C0392B;">R 177.12</b></div>
        <div class="d-flex justify-content-between py-2 border-bottom" style="font-size:.8rem;"><span class="text-muted">Pension fund (7.5%)</span><b style="color:#C0392B;">R 2 130.00</b></div>
        <div class="d-flex justify-content-between py-2 border-bottom" style="font-size:.8rem;"><span class="text-muted">Medical aid</span><b style="color:#C0392B;">R 660.88</b></div>
        <div class="d-flex justify-content-between pt-2" style="font-size:.85rem;"><b>Total deductions</b><b style="color:#C0392B;">R 9 186.58</b></div>
    </div></div>

    <div class="note note-ok mb-3">
        <span class="text-muted d-block" style="font-size:.68rem;font-weight:400;">Year to date</span>
        Gross R 234 535.00 &nbsp;&middot;&nbsp; PAYE R 43 530.06
    </div>

    <a class="btn-ovl w-100 d-block text-center mb-3" style="padding:14px;" href="#"><i class="fas fa-download me-2"></i>Download PDF</a>

    <h2 style="font-size:1rem;" class="mb-2">Previous payslips</h2>
    <div class="card"><div class="card-body p-3">
        <div class="d-flex justify-content-between py-2 border-bottom" style="font-size:.8rem;"><b>June 2026</b><span class="text-muted">R 23 884.17</span></div>
        <div class="d-flex justify-content-between py-2" style="font-size:.8rem;"><b>May 2026</b><span class="text-muted">R 24 102.65</span></div>
    </div></div>
</div>
